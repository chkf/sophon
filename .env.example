# Copy to .env. Values below are empty or synthetic examples; never commit .env.
GATEWAY_DATA_DIR=./data
GATEWAY_PROVIDER=api
# OpenAI-compatible Chat Completions API base, including /v1 if required.
# Example local endpoint: http://127.0.0.1:8000/v1
GATEWAY_API_BASE_URL=
# May be empty only when your endpoint does not require authentication.
GATEWAY_API_KEY=
# Exact model ID from your provider; tool calling must be supported.
GATEWAY_API_MODEL=
# Match the model's actual context window; minimum 8192.
GATEWAY_API_CONTEXT_WINDOW=32768
GATEWAY_API_VISION=false
GATEWAY_API_STREAM=true
GATEWAY_API_HEARTBEAT_ENABLED=false

TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
GATEWAY_ILINK_ENABLED=false

GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8790
# Mobile control center is automatic. Use npm start and Telegram /status.
# Missing cloudflared is downloaded from the official release and SHA-256 verified.
# Optional explicit executable path; otherwise reuse PATH or the verified managed copy.
GATEWAY_CLOUDFLARED_BIN=
GATEWAY_TIMEZONE=UTC
GATEWAY_MAX_TOOL_ROUNDS=20
# Structured per-turn capability decision; false is a compatibility override.
GATEWAY_TURN_DECISION_ENABLED=true
GATEWAY_HEARTBEAT_ENABLED=false
GATEWAY_HEARTBEAT_DAILY_PLANNING=false
GATEWAY_QUIET_START=01:00
GATEWAY_QUIET_END=07:00

# Local timestamped logs used by /logs. Defaults to <dataDir>/logs.
GATEWAY_LOG_DIR=
GATEWAY_LOG_ENABLED=true

# Local file tools are always enabled for the configured Telegram owner.
# Empty uses <GATEWAY_DATA_DIR>/files/generated; explicit save paths are also supported.
GATEWAY_GENERATED_FILES_DIR=

# Recent review runs automatically, independently of proactive messages.
# Background review uses the configured provider quota.

# Optional speech service (separate provider charges may apply).
DASHSCOPE_API_KEY=
# Your account's supported regional HTTPS API host, without a path.
GATEWAY_VOICE_BASE_URL=

# Portable encryption key for iLink and optional SIWC credentials.
# Create with: npm run credentials:create -- ./secrets/chatgpt-credential.key
GATEWAY_CREDENTIAL_KEY_FILE=

# Optional provider-specific features: choose GATEWAY_PROVIDER=openrouter.
# Generic API mode does not use these credentials or vendor extensions.
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=
OPENROUTER_IMAGE_MODEL=
OPENROUTER_WEB_SEARCH=false
OPENROUTER_HEARTBEAT_ENABLED=false

# Optional ChatGPT sign-in adapter: read docs/optional-siwc.md first.
GATEWAY_SIWC_DEVKIT_DIR=./vendor/siwc

# Memory graph is always enabled; startup prepares it automatically.
# Classification requires SIWC and consumes model quota. See docs/memory-graph.md.

# Optional MCP client configuration; empty means no external tools or processes.
GATEWAY_MCP_CONFIG=
